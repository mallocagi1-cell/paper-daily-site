      "title": "Think Thrice Before Reranking: Multi-perspective Evidence and Reasoning Integration for Text Reranking",
      "published": "2026-09-17",
      "authors": "Lijun Liu, Zhengzong Chen, Wenyan Li, Yuanyuan Zhao, Fei Huang",
      "abstract": "MERIT-Rank combines multiple reasoning trajectories using Progressive Rank Policy Optimization; 4B outperforms most 7B and 32B rerankers on BRIGHT.",
      "url": "https://arxiv.org/abs/2609.20131",
      "source": "web_search",
      "discovered_at": "2026-09-21",
      "scores": {
        "business_relevance": 5,
